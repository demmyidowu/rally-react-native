rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEduEmail() {
      return request.auth.token.email.matches('.*\\.edu$');
    }
    
    // Alias for backward compatibility
    function isKSUEmail() {
      return isEduEmail();
    }

    // Check email verification from Firestore user document
    // This is more reliable than request.auth.token.email_verified which can be stale
    function isEmailVerified() {
      // First try the token (faster, works after re-login)
      // If token says verified, we're good
      // Otherwise fall back to Firestore check (handles stale tokens)
      return request.auth.token.email_verified == true ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isEmailVerified == true;
    }

    function hasAccess() {
      return isSignedIn() && isKSUEmail() && isEmailVerified();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasAccess() && getUserData().role == 'admin';
    }

    function isSameChapter(chapterId) {
      return hasAccess() && getUserData().chapterId == chapterId;
    }

    function isOwner(userId) {
      return hasAccess() && request.auth.uid == userId;
    }

    // ========================================
    // USERS COLLECTION
    // ========================================

    match /users/{userId} {
      // Users can read their own document (even before verification for signup flow)
      // Other users require full verification
      allow read: if isSignedIn() && (request.auth.uid == userId || hasAccess());

      // Users can create their own account (during signup, before email verified)
      allow create: if isSignedIn() &&
                       isKSUEmail() &&
                       request.auth.uid == userId &&
                       request.resource.data.email == request.auth.token.email;

      // Users can update their own profile (even before verification) OR admins can update anyone
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ========================================
    // CHAPTERS COLLECTION (under universities)
    // ========================================

    match /universities/{universityId}/chapters/{chapterId} {
      // All signed-in users can read chapters (needed during signup flow)
      allow read: if isSignedIn();

      // Only admins can create, update, or delete chapters
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // UNIVERSITIES COLLECTION
    // ========================================

    match /universities/{universityId} {
      // All authenticated users can read universities (needed for signup)
      allow read: if isSignedIn();

      // Only Cloud Functions can write universities (no client-side writes)
      allow write: if false;
    }

    // ========================================
    // EVENTS COLLECTION
    // ========================================

    match /events/{eventId} {
      // All verified users can read events
      allow read: if hasAccess();

      // Only admins can create, update, or delete events
      allow create, update, delete: if isAdmin();

      // DD Assignments Subcollection (legacy - keep for backward compatibility)
      match /ddAssignments/{assignmentId} {
        // Anyone can read DD assignments
        allow read: if hasAccess();

        // Admins can create/delete DD assignments
        allow create, delete: if isAdmin();

        // Admins OR the DD themselves can update their assignment
        allow update: if isAdmin() || isOwner(assignmentId);
      }
    }

    // ========================================
    // DD ASSIGNMENTS COLLECTION (top-level)
    // ========================================

    match /ddAssignments/{assignmentId} {
      // All verified users can read DD assignments
      allow read: if hasAccess();

      // Only admins can create or delete DD assignments
      allow create, delete: if isAdmin();

      // Admins OR the DD themselves can update their assignment
      allow update: if hasAccess() && (
        isAdmin() || 
        request.auth.uid == resource.data.ddId
      );
    }

    // ========================================
    // RIDES COLLECTION
    // ========================================

    match /rides/{rideId} {
      // All verified users can read rides
      allow read: if hasAccess();

      // Users can create a ride request for themselves
      allow create: if hasAccess() &&
                       request.auth.uid == request.resource.data.riderId;

      // Riders, DDs, or admins can update rides
      allow update: if hasAccess() &&
                       (request.auth.uid == resource.data.riderId ||
                        request.auth.uid == resource.data.ddId ||
                        isAdmin());

      // Only admins can delete rides (for cleanup)
      allow delete: if isAdmin();
    }

    // ========================================
    // JOIN REQUESTS COLLECTION
    // ========================================

    match /joinRequests/{requestId} {
      // Users can read their own join requests (even before full verification)
      // Admins can read requests for their chapter
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        (hasAccess() && isAdmin() && getUserData().chapterId == resource.data.chapterId)
      );

      // Users can create their own join requests
      allow create: if isSignedIn() &&
                       isKSUEmail() &&
                       request.auth.uid == request.resource.data.userId;

      // Admins can update requests (approve/reject) for their chapter
      allow update: if isAdmin() && getUserData().chapterId == resource.data.chapterId;

      // Users can delete (cancel) their own pending requests
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // ADMIN ALERTS COLLECTION
    // ========================================

    match /adminAlerts/{alertId} {
      // Only admins from the same chapter can read alerts
      allow read: if isAdmin() &&
                     (resource == null || isSameChapter(resource.data.chapterId));

      // Only admins from the same chapter can create alerts
      allow create: if isAdmin() && isSameChapter(request.resource.data.chapterId);

      // Only admins from the same chapter can update/delete alerts
      allow update, delete: if isAdmin() && isSameChapter(resource.data.chapterId);
    }

    // ========================================
    // YEAR TRANSITION LOGS COLLECTION
    // ========================================

    match /yearTransitionLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // Only Cloud Functions can write logs (no client-side writes allowed)
      allow write: if false;
    }
  }
}
