{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "development"
            },
            "secretFiles": {
                "GoogleService-Info.plist": "GOOGLE_SERVICE_INFO_PLIST",
                "google-services.json": "GOOGLE_SERVICES_JSON"
            }
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "preview"
            },
            "secretFiles": {
                "GoogleService-Info.plist": "GOOGLE_SERVICE_INFO_PLIST",
                "google-services.json": "GOOGLE_SERVICES_JSON"
            }
        },
        "production": {
            "distribution": "store",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "APP_ENV": "production"
            },
            "autoIncrement": true,
            "secretFiles": {
                "GoogleService-Info.plist": "GOOGLE_SERVICE_INFO_PLIST",
                "google-services.json": "GOOGLE_SERVICES_JSON"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "didowu123@gmail.com",
                "ascAppId": "6759846727"
            },
            "android": {
                "serviceAccountKeyPath": "./google-play-service-account.json",
                "track": "internal"
            }
        }
    }
}