{
  "expo": {
    "name": "RallyRide",
    "slug": "rally-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "didowu",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7B68A8"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.RallyRideios.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RallyRide needs your location to calculate accurate pickup locations and ETAs for designated driver rides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RallyRide needs your location to calculate accurate pickup locations and ETAs for designated driver rides.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.RallyRide.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#7B68A8"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RallyRide needs your location to calculate accurate pickup locations and ETAs for designated driver rides.",
          "locationWhenInUsePermission": "RallyRide needs your location to calculate accurate pickup locations and ETAs for designated driver rides."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#7B68A8"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withModularHeaders"
    ],
    "extra": {
      "eas": {
        "projectId": "a3bc2ad2-a1d1-4191-a42d-71128f256bc6"
      }
    }
  }
}